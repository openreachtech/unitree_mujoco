<mujoco model="go2 scene (2S1 block double-bottom interior, real shipyard design data)">
  <include file="go2.xml"/>

  <!-- Solver settings from the reference scene (scene_2s1_bottom.xml), validated there
       with ball-drop contact tests against this same heightfield's fine (20mm-pixel)
       detail. Without these the default solver struggled badly with this mesh (observed:
       sim effectively stalled, /livox/lidar stopped publishing entirely). -->
  <option timestep="0.002" iterations="30" solver="Newton"/>
  <default><geom solref="0.005 1" friction="0.9 0.02 0.001"/></default>

  <!-- 福岡造船 呉工場 2S1 ブロック 二重底内部 (設計DXF実測データ, Tsuruta氏提供).
       heightfield: 500x800px, 1px=20mm, 高さ 0..0.60m スケール。基準面=内底板 (z=0)。
       ロンジ(縦通材)高さ0.23m、ガーダー/フロアは壁 (README_hfield.md参照)。

       Reference scene (scene_2s1_bottom.xml) placed a Go2-sized marker at local hfield
       xy (-1.0, -2.76) as a good flat bay starting point; the hfield geom here is offset
       by (1.0, 2.76) so that point lands under the robot's fixed world spawn (0, 0, ...) -
       see scene_2s1_top_eval.xml for why the hfield moves instead of the robot. -->
  <statistic center="0 0 0.3" extent="1.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.5 0.6 0.7" rgb2="0.9 0.9 0.95" width="256" height="256"/>
    <texture name="steel" type="2d" builtin="checker" rgb1="0.45 0.48 0.55" rgb2="0.40 0.43 0.50" width="64" height="64"/>
    <material name="steel" texture="steel" texrepeat="40 64" specular="0.4" shininess="0.3"/>
    <hfield name="bottom" file="../2s1/2s1_bottom.png" size="5.0 8.0 0.60 0.10"/>
  </asset>

  <worldbody>
    <light pos="3 -4 6" dir="-0.35 0.45 -0.85" diffuse="0.9 0.9 0.9"/>
    <light pos="-4 5 5" diffuse="0.4 0.4 0.45"/>
    <geom type="hfield" hfield="bottom" pos="1.0 2.76 0" material="steel" friction="0.9 0.02 0.001"/>
  </worldbody>
</mujoco>
