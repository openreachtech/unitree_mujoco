<mujoco model="go2 scene (2S1 block manhole/gate passage, real shipyard design data)">
  <include file="go2.xml"/>

  <option timestep="0.002" iterations="30" solver="Newton"/>
  <default><geom solref="0.005 1" friction="0.9 0.02 0.001"/></default>

  <!-- 福岡造船 2S1 ブロック 実人通孔シーン (設計DXF実測データ, Tsuruta氏提供).
       人通孔を挟む2区画 (2.5x3.2m)、開口760x560mm・敷居480mmが実際に開いている
       (heightfieldは(x,y)ごとに高さ1つの2.5D表現で縦壁に穴を開けられないため、
       周辺はhfield、開口を含む対象フロアだけ箱4枚で再構成するハイブリッド構成 -
       README_gate.md参照)。

       Reference scene (scene_2s1_gate.xml) placed a Go2-sized marker at local xy
       (-0.6, 0) in "bay A" (ahead of the gate); every static geom here (the hfield and
       the 4 floor boxes forming the opening) is shifted by (+0.6, 0) so that point
       lands under the robot's fixed world spawn (0, 0, ...) - same approach as
       scene_2s1_top_eval.xml/scene_2s1_bottom_eval.xml. -->
  <statistic center="0 0 0.3" extent="1.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.5 0.6 0.7" rgb2="0.9 0.9 0.95" width="256" height="256"/>
    <texture name="steel" type="2d" builtin="checker" rgb1="0.45 0.48 0.55" rgb2="0.40 0.43 0.50" width="64" height="64"/>
    <material name="steel" texture="steel" texrepeat="10 12" specular="0.4" shininess="0.3"/>
    <hfield name="bays" file="../2s1_gate/2s1_gate.png" size="1.25 1.60 0.6 0.10"/>
  </asset>

  <worldbody>
    <light pos="2 -3 5" dir="-0.3 0.4 -0.85" diffuse="0.9 0.9 0.9"/>
    <light pos="-3 3 4" diffuse="0.45 0.45 0.5"/>
    <geom type="hfield" hfield="bays" pos="0.6 0 0" material="steel"/>
    <geom name="floor_below" type="box" pos="0.570 0.000 0.240" size="0.011 1.600 0.240" material="steel"/>
    <geom name="floor_above" type="box" pos="0.570 0.000 1.120" size="0.011 1.600 0.080" material="steel"/>
    <geom name="floor_left" type="box" pos="0.570 -0.990 0.760" size="0.011 0.610 0.280" material="steel"/>
    <geom name="floor_right" type="box" pos="0.570 0.990 0.760" size="0.011 0.610 0.280" material="steel"/>
  </worldbody>
</mujoco>
