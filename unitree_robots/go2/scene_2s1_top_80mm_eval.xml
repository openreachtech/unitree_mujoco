<mujoco model="go2 scene (2S1 block tank-top surface, real shipyard design data, 80mm/px)">
  <include file="go2.xml"/>

  <option timestep="0.002" iterations="30" solver="Newton"/>
  <default><geom solref="0.005 1" friction="0.9 0.02 0.001"/></default>

  <!-- 80mm/px version of scene_2s1_top_eval.xml, regenerated directly from the source
       USD (blocks/2S1.usd, via kasai-6-server's usd2hfield.py) at 80mm/px instead of the
       original 20mm/px. MuJoCo's ray-vs-hfield cost (mj_multiRay) was benchmarked at
       ~482ms/scan at 20mm/px vs ~52ms/scan at 80mm/px for a fixed sensor pose (see
       session notes) - the earlier confusing result where a coarser regeneration looked
       SLOWER was an artifact of also matching the raw USD's full 0..1.78m z-range
       instead of windowing to the ~0.45m band actually used near the deck; this version
       windows z to [floor-0.02, floor+0.45] (floor=1.59, the deck level) same as the
       original. Same 500x800 -> 125x200 cell reduction area (crop -5,5,-8,8). -->
  <statistic center="0 0 0.3" extent="1.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.5 0.6 0.7" rgb2="0.9 0.9 0.95" width="256" height="256"/>
    <texture name="steel" type="2d" builtin="checker" rgb1="0.45 0.48 0.55" rgb2="0.40 0.43 0.50" width="64" height="64"/>
    <material name="steel" texture="steel" texrepeat="40 64" specular="0.4" shininess="0.3"/>
    <hfield name="tanktop" file="../2s1_80mm/2S1_top_80mm.png" size="5.0 8.0 0.47 0.10"/>
  </asset>

  <worldbody>
    <light pos="3 -4 6" dir="-0.35 0.45 -0.85" diffuse="0.9 0.9 0.9"/>
    <light pos="-4 5 5" diffuse="0.4 0.4 0.45"/>
    <geom type="hfield" hfield="tanktop" pos="0 4 0" material="steel" friction="0.9 0.02 0.001"/>
  </worldbody>
</mujoco>
