<mujoco model="go2 scene (open space + climbable steps, walled for stable LIO)">
  <include file="go2.xml"/>

  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- 4-step staircase directly ahead of spawn (+X), rising 0.15m per step to 0.6m
         total. Tread depth 0.3m, 1m wide - open path, nothing else in the way, so the
         Phase3-balance-floating policy's stair-climbing behavior can be evaluated
         without the near-field clutter of scene_cluttered_eval.xml interfering. -->
    <geom pos="1.0 0 0.075" type="box" size="0.15 0.5 0.075" rgba="0.55 0.55 0.55 1"/>
    <geom pos="1.3 0 0.15" type="box" size="0.15 0.5 0.15" rgba="0.55 0.55 0.55 1"/>
    <geom pos="1.6 0 0.225" type="box" size="0.15 0.5 0.225" rgba="0.55 0.55 0.55 1"/>
    <geom pos="1.9 0 0.3" type="box" size="0.15 0.5 0.3" rgba="0.55 0.55 0.55 1"/>

    <!-- Low near-field boxes off to the sides (|y|>=0.65, clear of the 1m-wide stair
         path at y in [-0.5, 0.5]) - close-range vertical structure below the MID-360's
         mount height, complementing the tall/far walls below (same idea as
         scene_cluttered_eval.xml's near-field clutter). -->
    <geom pos="0.6 0.75 0.05" type="box" size="0.15 0.15 0.05" rgba="0.6 0.3 0.2 1"/>
    <geom pos="0.6 -0.75 0.075" type="box" size="0.15 0.15 0.075" rgba="0.6 0.3 0.2 1"/>
    <geom pos="-0.6 0.75 0.06" type="box" size="0.15 0.15 0.06" rgba="0.3 0.5 0.3 1"/>
    <geom pos="-0.6 -0.75 0.09" type="box" size="0.15 0.15 0.09" rgba="0.3 0.5 0.3 1"/>
    <geom pos="0 1.0 0.04" type="box" size="0.15 0.15 0.04" rgba="0.3 0.3 0.6 1"/>
    <geom pos="0 -1.0 0.07" type="box" size="0.15 0.15 0.07" rgba="0.3 0.3 0.6 1"/>

    <!-- Same taller/farther walls that stabilized stationary LIO in
         scene_cluttered_eval.xml (2m tall, 3m out) - keeps the open floor from being a
         degenerate, mostly-planar ICP scan while leaving the stair path itself clear. -->
    <geom pos="3.0 0 1.0" type="box" size="0.05 3.2 1.0" rgba="0.5 0.5 0.5 1"/>
    <geom pos="-3.0 0 1.0" type="box" size="0.05 3.2 1.0" rgba="0.5 0.5 0.5 1"/>
    <geom pos="0 3.0 1.0" type="box" size="3.2 0.05 1.0" rgba="0.5 0.5 0.5 1"/>
    <geom pos="0 -3.0 1.0" type="box" size="3.2 0.05 1.0" rgba="0.5 0.5 0.5 1"/>
  </worldbody>
</mujoco>
