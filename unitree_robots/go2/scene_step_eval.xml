<mujoco model="go2 scene (single step-up to cross, walled for stable LIO)">
  <include file="go2.xml"/>

  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Single step-up ("段差"), not a full staircase: one 0.18m riser (mid-range of
         the training terrain's step_height_range=(0.05, 0.25)) leading onto a 2m-long
         flat platform (matching the training terrain's platform_width=2.0), 1.5m wide.
         This matches "pyramid_stairs_wide" from PHASE3_TERRAIN_CFG_VARIABLE_WIDTH at
         low-to-mid difficulty - the sub-terrain the training code itself comments as
         "段差、踏み幅広め" (a step, wide tread), as opposed to "pyramid_stairs"/
         "pyramid_stairs_inv" which are the repeated-tread full staircases. -->
    <geom pos="1.8 0 0.09" type="box" size="1.0 0.75 0.09" rgba="0.55 0.55 0.55 1"/>

    <!-- Low near-field boxes off to the sides (|y|>=0.9, clear of the step's 1.5m
         width), same idea as scene_stair_climb_eval.xml. -->
    <geom pos="0.6 1.05 0.05" type="box" size="0.15 0.15 0.05" rgba="0.6 0.3 0.2 1"/>
    <geom pos="0.6 -1.05 0.075" type="box" size="0.15 0.15 0.075" rgba="0.6 0.3 0.2 1"/>
    <geom pos="-0.6 1.05 0.06" type="box" size="0.15 0.15 0.06" rgba="0.3 0.5 0.3 1"/>
    <geom pos="-0.6 -1.05 0.09" type="box" size="0.15 0.15 0.09" rgba="0.3 0.5 0.3 1"/>
    <geom pos="0 1.3 0.04" type="box" size="0.15 0.15 0.04" rgba="0.3 0.3 0.6 1"/>
    <geom pos="0 -1.3 0.07" type="box" size="0.15 0.15 0.07" rgba="0.3 0.3 0.6 1"/>

    <!-- Same taller/farther walls that stabilized stationary LIO in
         scene_cluttered_eval.xml (2m tall, 3m out). -->
    <geom pos="3.5 0 1.0" type="box" size="0.05 3.7 1.0" rgba="0.5 0.5 0.5 1"/>
    <geom pos="-3.5 0 1.0" type="box" size="0.05 3.7 1.0" rgba="0.5 0.5 0.5 1"/>
    <geom pos="0 3.5 1.0" type="box" size="3.7 0.05 1.0" rgba="0.5 0.5 0.5 1"/>
    <geom pos="0 -3.5 1.0" type="box" size="3.7 0.05 1.0" rgba="0.5 0.5 0.5 1"/>
  </worldbody>
</mujoco>
