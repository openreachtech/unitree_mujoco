<mujoco model="scene">
  <option timestep="0.005"/>
  <include file="go2.xml"/>

  <!--
  <default>
    <joint armature="0.05" damping="1" limited="true" frictionloss="0.1"/>
    <general dyntype="filterexact" dynprm="0.01"/>
  </default>
  -->

  <visual>
    <headlight diffuse="0.6 0.6 0.6"  ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
        height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
        rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
        reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" pos="0 0 0.0" size="0 0 0.05" type="plane" material="groundplane"/>

    <body name="pyramid_staircase" pos="4 4 0">
      <geom name="step_1" type="box" pos="0 0 0.05" size="2.5 2.5 0.05" rgba="0.8 0.6 0.4 1"/>
      <geom name="step_2" type="box" pos="0 0 0.15" size="2.2 2.2 0.05" rgba="0.75 0.65 0.45 1"/>
      <geom name="step_3" type="box" pos="0 0 0.25" size="1.9 1.9 0.05" rgba="0.7 0.7 0.5 1"/>
      <geom name="step_4" type="box" pos="0 0 0.35" size="1.6 1.6 0.05" rgba="0.65 0.75 0.55 1"/>
      <geom name="step_5" type="box" pos="0 0 0.45" size="1.3 1.3 0.05" rgba="0.6 0.8 0.6 1"/>
      <geom name="step_6" type="box" pos="0 0 0.55" size="1.0 1.0 0.05" rgba="0.55 0.85 0.65 1"/>
      <geom name="step_7" type="box" pos="0 0 0.65" size="0.7 0.7 0.05" rgba="0.5 0.9 0.7 1"/>
    </body>

    <body name="pyramid_staircase_1step" pos="4 -4 0">
      <geom name="step_1_single" type="box" pos="0 0 0.04" size="2.5 2.5 0.04" rgba="0.8 0.6 0.4 1"/>
    </body>
  </worldbody>

  <keyframe>
    <key name="STANDBY"
      qpos="0 0 0 0 0 0 0 -0.15 1.325 -2.8731 0.15 1.325 -2.8731 -0.15 1.325 -2.8731 0.15 1.325 -2.8731"
      ctrl="-0.15 1.325 -2.8731 0.15 1.325 -2.8731 -0.15 1.325 -2.8731 0.15 1.325 -2.8731" />
  </keyframe>

